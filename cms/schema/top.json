{
  "apiFields": [
    {
      "fieldId": "heroSlides",
      "name": "ヒーローの写真",
      "kind": "repeater",
      "description": "最初に表示される大きな写真。2枚以上で自動で切り替わります。",
      "required": true,
      "customFieldIds": [
        "heroSlide"
      ]
    },
    {
      "fieldId": "heroCopy",
      "name": "キャッチコピー",
      "kind": "textArea",
      "description": "改行するとそこで行が変わります。[[ ]] で囲んだ語句は途中で折り返しません。 ※いまの文は依頼時に指定された文言です。",
      "required": false
    },
    {
      "fieldId": "heroLead",
      "name": "キャッチコピーの下の文",
      "kind": "textArea",
      "description": "※いまの文は依頼時に指定された文言です。",
      "required": false
    },
    {
      "fieldId": "heroPrimaryLabel",
      "name": "LINE ボタンの文字",
      "kind": "text",
      "description": "押すと公式LINE が開きます。空ならボタンなし。",
      "required": false
    },
    {
      "fieldId": "heroSecondaryLabel",
      "name": "2つ目のボタンの文字",
      "kind": "text",
      "description": "「活動内容」へ移動します（なければ最初のセクション）。",
      "required": false
    },
    {
      "fieldId": "heroPartnerLabel",
      "name": "こども食堂向けリンクの文字",
      "kind": "text",
      "description": "「参加する」で案内を出しているときだけ表示されます。",
      "required": false
    },
    {
      "fieldId": "heroAffilLabel",
      "name": "大学ロゴの横の文字",
      "kind": "text",
      "description": "例: 長崎大学 認定サークル",
      "required": false
    },
    {
      "fieldId": "newsTitle",
      "name": "お知らせ欄の見出し",
      "kind": "text",
      "description": "空なら「お知らせ」。お知らせそのものは「お知らせ」の API で書きます。",
      "required": false
    },
    {
      "fieldId": "sections",
      "name": "セクション（上から順に表示）",
      "kind": "repeater",
      "description": "並べ替え・追加・削除ができます。「自由セクション」以外は1回ずつ使えます。",
      "required": true,
      "customFieldIds": [
        "sec_about",
        "sec_activities",
        "sec_day",
        "sec_promise",
        "sec_flow",
        "sec_gallery",
        "sec_faq",
        "sec_join",
